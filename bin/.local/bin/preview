#!/bin/bash
# Herdr Preview CLI: opens markdown / document preview in Herdr

RAW="${1:-AGENTS.md}"

# If it is a herdr:// URL, extract path
if [[ "$RAW" == herdr://* ]]; then
  TARGET=$(python3 -c "
import urllib.parse, sys
u = sys.argv[1]
p = urllib.parse.urlparse(u)
qs = urllib.parse.parse_qs(p.query)
val = qs.get('path', qs.get('file', [p.path.lstrip('/')]))[0]
print(val)
" "$RAW")
else
  TARGET="$RAW"
fi

# Resolve absolute path
if [[ -f "$TARGET" ]]; then
  ABS_PATH=$(python3 -c "import os, sys; print(os.path.abspath(sys.argv[1]))" "$TARGET")
elif [[ -f "$PWD/$TARGET" ]]; then
  ABS_PATH="$PWD/$TARGET"
elif [[ -f "$PWD/AGENTS.md" ]]; then
  ABS_PATH="$PWD/AGENTS.md"
else
  ABS_PATH=$(python3 -c "import os, sys; print(os.path.abspath(sys.argv[1]))" "$TARGET")
fi

FILE_NAME=$(basename "$ABS_PATH")
DIR_NAME=$(dirname "$ABS_PATH")
PREVIEW_DIR="$HOME/.local/state/herdr-preview"

mkdir -p "$PREVIEW_DIR"

python3 -c "
import json, time, os, sys
p = sys.argv[1]
fn = sys.argv[2]
dn = sys.argv[3]
data = {'path': p, 'file': fn, 'cwd': dn, 'ts': int(time.time() * 1000)}
with open(os.path.expanduser('~/.local/state/herdr-preview/request.json'), 'w') as f:
    json.dump(data, f)
" "$ABS_PATH" "$FILE_NAME" "$DIR_NAME"

echo "✓ Opening preview for $FILE_NAME in Herdr..."
