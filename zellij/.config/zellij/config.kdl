            background 52 47 42
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        list_unselected {
            base 224 216 208
            background 22 20 19
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        frame_selected {
