// =============================================================================
// Zellij Terminal Multiplexer Configuration (~/.config/zellij/config.kdl)
// Theme: Cukup Kopi (Minimal Flat Bottom Tab Bar — No Buttons/Boxes)
// Managed via GNU Stow in ~/.dotfiles/zellij/.config/zellij/config.kdl
// Docs: https://zellij.dev/documentation/configuration
// =============================================================================

theme "cukup-kopi"
theme_dark "cukup-kopi"
theme_light "cukup-terang"
default_layout "compact"
pane_frames false
simplified_ui true
mouse_mode true
copy_on_select true
scroll_buffer_size 50000
on_force_close "quit"
session_serialization false
show_startup_tips false

// -----------------------------------------------------------------------------
// Custom Theme: Cukup Kopi (Seamless transparent background so tabs appear as flat text,
// not buttons/boxes, matching Alacritty & Zed Cukup Kopi Blurred)
// -----------------------------------------------------------------------------
themes {
    cukup-kopi {
        text_unselected {
            base 232 125 75         // #E87D4B Persimmon orange (badge bg & active modes)
            background 0            // 0 = ANSI Default transparent background
            emphasis_0 232 125 75   // #E87D4B Persimmon orange
            emphasis_1 94 158 160   // #5E9EA0 Ceramic blue
            emphasis_2 184 150 158  // #B8969E Cashmere Mauve for NORMAL mode on the far right
            emphasis_3 210 92 84    // #D25C54 Paprika red (LOCKED mode indicator)
        }
        text_selected {
            base 246 241 234        // #F6F1EA Bright oat white
            background 0            // 0 = ANSI Black -> transparent
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        ribbon_unselected {
            base 216 208 200        // #D8D0C8 Oat Silk inactive tab text (clean, warm, highly readable)
            background 0            // 0 = Transparent inactive tab background (no solid boxes)
            emphasis_0 232 125 75   // #E87D4B Persimmon orange
            emphasis_1 0            // 0 = Transparent alternate tab background
            emphasis_2 94 158 160   // #5E9EA0 Ceramic blue
            emphasis_3 210 92 84    // #D25C54 Paprika red
        }
        ribbon_selected {
            base 22 20 19           // #161413 Dark espresso text on Persimmon badge
            background 232 125 75   // #E87D4B Persimmon Orange active badge!
            emphasis_0 22 20 19
            emphasis_1 22 20 19
            emphasis_2 22 20 19
            emphasis_3 210 92 84
        }
        table_title {
            base 232 125 75
            background 22 20 19
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        table_cell_selected {
            base 246 241 234
            background 52 47 42
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        table_cell_unselected {
            base 224 216 208
            background 22 20 19
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        list_selected {
