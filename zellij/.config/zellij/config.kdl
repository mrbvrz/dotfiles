            background 0
            emphasis_0 232 125 75
            emphasis_1 94 158 160
            emphasis_2 184 150 158
            emphasis_3 210 92 84
        }
        frame_unselected {
            base 52 47 42           // #342F2A subtle dark border for unfocused split panes
            background 0
            emphasis_0 64 57 51
            emphasis_1 64 57 51
            emphasis_2 64 57 51
            emphasis_3 64 57 51
        }
        frame_highlight {
            base 94 158 160
            background 0
            emphasis_0 184 150 158
            emphasis_1 232 125 75
            emphasis_2 94 158 160
            emphasis_3 94 158 160
        }
        exit_code_success {
            base 125 174 114
            background 0
            emphasis_0 125 174 114
            emphasis_1 22 20 19
            emphasis_2 184 150 158
            emphasis_3 125 174 114
        }
        exit_code_error {
            base 210 92 84
            background 0
            emphasis_0 232 125 75
            emphasis_1 22 20 19
            emphasis_2 184 150 158
            emphasis_3 125 174 114
        }
        multiplayer_user_colors {
            player_1 232 125 75
            player_2 94 158 160
            player_3 184 150 158
            player_4 204 160 98
            player_5 125 174 114
            player_6 210 92 84
        }
    }
