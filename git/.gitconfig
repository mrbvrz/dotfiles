[user]
	name = mrbvrz
	email = 3890123+mrbvrz@users.noreply.github.com

[include]
	path = ~/.gitconfig.local

[core]
	editor = zed --wait
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = TwoDark
	plus-style = syntax "#1a2d1a"
	minus-style = syntax "#33181b"
	plus-emph-style = syntax "#284a28"
	minus-emph-style = syntax "#542227"
	line-numbers-left-format = "{nm:>4}┊"
	line-numbers-right-format = "{np:>4}│"
	line-numbers-left-style = "#5C5C5C"
	line-numbers-right-style = "#5C5C5C"
	line-numbers-minus-style = "#FA7584"
	line-numbers-plus-style = "#79B8FF"
	file-style = bold "#B392F1"
	file-decoration-style = "#B392F1" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#FFAB70" box

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[credential "https://github.com"]
	helper = 
	helper = "!f() { /opt/homebrew/bin/gh auth git-credential \"$@\" 2>/dev/null || gh auth git-credential \"$@\"; }; f"

[credential "https://gist.github.com"]
	helper = 
	helper = "!f() { /opt/homebrew/bin/gh auth git-credential \"$@\" 2>/dev/null || gh auth git-credential \"$@\"; }; f"
