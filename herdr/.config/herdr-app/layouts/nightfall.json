{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "nightfall-chrome"
          },
          "size": {
            "px": 66
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "nightfall-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "nightfall-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 36
          }
        }
      ],
      "size": {
        "px": 300
      },
      "min": 52,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "nightfall-tabs"
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "nightfall-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 6,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "filetree"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "nightfall-changes"
                      }
                    },
                    {
                      "id": "ci",
                      "type": "block",
                      "content": {
                        "mod": "ci-dash",
                        "props": {
                          "panel": true
                        }
                      }
                    },
                    {
                      "id": "slack",
                      "type": "block",
                      "content": {
                        "mod": "slack",
                        "props": {
                          "panel": true
                        }
                      }
                    }
                  ],
                  "active": "files"
                },
                {
                  "id": "yt-music",
                  "type": "block",
                  "content": {
                    "mod": "yt-music"
                  },
                  "size": {
                    "px": 0
                  },
                  "min": 0
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 6
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "session-bar"
          },
          "size": {
            "px": 28
          }
        },
        {
          "id": "slack-bg",
          "type": "block",
          "content": {
            "mod": "slack",
            "props": {
              "bg": true
            }
          },
          "size": {
            "px": 0
          },
          "min": 0
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "nightfall",
  "font": "CommitMono Nerd Font",
  "ui_font": "Uncut Sans",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.85,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/nightfall.svg",
  "ui_font_size": 14.0
}